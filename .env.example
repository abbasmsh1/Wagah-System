# Copy to .env and fill in real values. NEVER commit .env.
# Security Settings
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database Settings
DATABASE_URL=sqlite:///./wagah.db

# Initial admin bootstrap (only used when the users table is empty).
# If INITIAL_ADMIN_PASSWORD is unset, a random password is generated and
# written to the application log on first startup.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# Application Settings
DEBUG=False
ALLOWED_HOSTS=["localhost","127.0.0.1"]
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]

# Cookie Settings (set COOKIE_SECURE=True in production / HTTPS)
COOKIE_SECURE=True
COOKIE_HTTPONLY=True
COOKIE_SAMESITE=Lax

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Password Settings
MIN_PASSWORD_LENGTH=8
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15

# Session Settings
SESSION_EXPIRE_MINUTES=120
