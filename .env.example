# Copy to .env and fill in real values. NEVER commit .env.
# Security Settings
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database Settings
DATABASE_URL=sqlite:///./wagah.db

# Initial admin bootstrap (only used when the users table is empty).
# REQUIRED for first startup on an empty database: if INITIAL_ADMIN_PASSWORD
# is unset, no admin account is created (the app logs an error and continues).
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# Application Settings
DEBUG=False
ALLOWED_HOSTS=["localhost","127.0.0.1"]
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]

# Cookie Settings (set COOKIE_SECURE=True in production / HTTPS)
COOKIE_SECURE=True
COOKIE_HTTPONLY=True
COOKIE_SAMESITE=Lax

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Password Settings
MIN_PASSWORD_LENGTH=8

# Backup (backup.py). BACKUP_EXTERNAL_DIR is an optional second copy,
# e.g. a mounted external drive. Interval is in seconds.
BACKUP_DIR=backups
#BACKUP_EXTERNAL_DIR=/mnt/backup-drive/wagah
BACKUP_INTERVAL_SECONDS=3600
